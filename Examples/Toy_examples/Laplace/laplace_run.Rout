> #####################################################################
> ################## Laplace output #######################
> #####################################################################
> set.seed(100)
> source("laplace_functions.R")
> library(mcmcse)
> library(foreach)
> library(doParallel)
Loading required package: iterators
Loading required package: parallel
> 
> num_cores <- 4
> doParallel::registerDoParallel(cores = num_cores)
> 
> iter <- 1e4
> n_lambda <- 50
> reps <- 50  # Independent replications
> 
> lamb_d1 <- seq(0.1, 20, length = n_lambda)
> lamb_d5 <- seq(1e-2, 7, length = n_lambda)
> lamb_d10 <- seq(1e-2, 4, length = n_lambda)
> lamb_d20 <- seq(1e-2, 1.8, length = n_lambda)
> lamb_d50 <- seq(1e-2, 1.2, length = n_lambda)
> lamb_d100 <- seq(1e-2, .65, length = n_lambda)
> 
> 
> delta_is_d1 <- seq(2.8, 45, length = length(lamb_d1))
> delta_px_d1 <- seq(2.8, .8, length = length(lamb_d1))
> 
> delta_is_d5 <- seq(1.2, 12, length = length(lamb_d5))
> delta_px_d5 <- seq(1.2, 0.6, length = length(lamb_d5))
> 
> delta_is_d10 <- seq(0.75, 5.5, length = length(lamb_d10))
> delta_px_d10 <- seq(0.75, .40, length = length(lamb_d10))  
> 
> delta_is_d20 <- seq(0.45, 2, length = length(lamb_d20))
> delta_px_d20 <- seq(0.45, 0.3, length = length(lamb_d20))  
> 
> delta_is_d50 <- seq(0.23, 1, length = length(lamb_d50))
> delta_px_d50 <- seq(0.23, 0.16, length = length(lamb_d50))  
> 
> delta_is_d100 <- seq(0.14, 0.45, length = length(lamb_d100))
> delta_px_d100 <- seq(0.14, 0.15, length = length(lamb_d100))  
> 
> output_laplace_d1 <- list()
> output_laplace_d5 <- list()
> output_laplace_d10 <- list()
> output_laplace_d20 <- list()
> output_laplace_d50 <- list()
> output_laplace_d100 <- list()
> 
> ######################  dimension = 1  ################################
> 
> # Indexed as [[replication]][[lambda]][[metric]].
> output_laplace_d1 <- foreach(rep_ani = seq_len(reps), .packages = "mcmcse") %dopar% {
+   set.seed(100 + 1 * reps + rep_ani)
+   lapply(seq_along(lamb_d1), function(lam_ani) {
+   
+   output_mala_d1 <- dimen_func(d = 1, lambda = lamb_d1[lam_ani], iter = iter,
+                                delta_is_d1[lam_ani], delta_px_d1[lam_ani])
+   
+   asymp_cov_ism_d1 <- asymp_covmat_fn(output_mala_d1[[1]][[1]], exp(output_mala_d1[[1]][[2]]))
+   asymp_ess_pilam_d1 <- ess(output_mala_d1[[1]][[1]], r = 1)
+   asymp_cov_pxm_d1 <- mcse.multi(output_mala_d1[[2]], r = 1)$cov
+   
+   asymp_margvar_is1 <- diag(asymp_cov_ism_d1)   ### marginal variance ismala
+  # asymp_margvar_pilam1 <- diag(asymp_cov_pilam_d1)   ### marginal variance of is for pilambda
+   time_is1 <- output_mala_d1[[3]]
+   time_px1 <- output_mala_d1[[4]]
+   rel_eff_1 <- (diag(asymp_cov_pxm_d1) * time_px1) / (asymp_margvar_is1 * time_is1) ### relative efficiency wrt pi
+   
+   wts <- exp(output_mala_d1[[1]][[2]])
+   ess_ism_d1 <- (mean(wts)^2)/mean(wts^2)
+   
+   list(asymp_margvar_is1, asymp_ess_pilam_d1, rel_eff_1, ess_ism_d1)
+   })
+ }
