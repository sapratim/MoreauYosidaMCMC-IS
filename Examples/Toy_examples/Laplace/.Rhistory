}
legend(
"topright",
legend = c(
"Original Laplace density",
"Exact MY envelope",
paste0("Delta-MY, delta = ", delta_seq)
),
col = c("black", "blue", delta_cols),
lty = c(1, 2, rep(3, length(delta_seq))),
lwd = 2,
cex = 0.8,
bty = "n"
)
